WIKI_IMAGE=ghcr.io/requarks/wiki:3
WIKI_NETWORK=docs-wiki_default
INFRA_WIKI_DB_NETWORK=infra_wiki_db
WIKI_CONTENT_VOLUME=docs_wiki_content
WIKI_REPO_VOLUME=docs_wiki_repo

# Keep the web port on loopback until a domain and reverse proxy are configured.
WIKI_PUBLISH_BIND=127.0.0.1
WIKI_PUBLISH_PORT=18080

WIKI_DB_HOST=postgres
WIKI_DB_PORT=5432
WIKI_DB_NAME=wikijs
WIKI_DB_USER=wikijs
WIKI_DB_SCHEMA=wiki
WIKI_DB_SSL=false

WIKI_ADMIN_EMAIL=admin@example.com
WIKI_ADMIN_PASSWORD=replace-with-a-long-random-password
