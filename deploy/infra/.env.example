# Shared middleware Compose environment.
# Copy to /opt/infra/.env on the server and fill secrets locally.

INFRA_NETWORK=infra_backend
INFRA_ACCESS_NETWORK=infra_access

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=
POSTGRES_VOLUME=infra_postgres_data

REDIS_IMAGE=redis:7-alpine
REDIS_PUBLISH_PORT=16382
REDIS_VOLUME=synapse_synapse-redis-data

QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_PUBLISH_PORT=16334
QDRANT_VOLUME=synapse_synapse-qdrant-data

RUSTFS_IMAGE=ghcr.io/rustfs/rustfs:1.0.4
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Server layout; use a local path when running this Compose elsewhere.
RUSTFS_DATA_PATH=/opt/infra/RustFS/data
RUSTFS_S3_PORT=19000
RUSTFS_CONSOLE_PORT=19001

# Glances is loopback-only and intended to be reached through an SSH tunnel.
GLANCES_IMAGE=nicolargo/glances:4.5.9
GLANCES_PORT=16128
