# Copy this file to .env.docker and fill in both secrets before deployment.

SYNAPSE_ENV=production
SYNAPSE_DEBUG=false
SYNAPSE_JWT_SECRET=
SYNAPSE_AGENTSCOPE_CREDENTIAL_ENCRYPTION_KEY=

# Set true behind HTTPS. The local HTTP Docker setup explicitly uses false.
SYNAPSE_AUTH_COOKIE_SECURE=false

# Public ports
SYNAPSE_WEB_PORT=80
SYNAPSE_API_PORT=8010

# Local-only diagnostics ports for infrastructure
SYNAPSE_REDIS_PUBLISH_PORT=16382
SYNAPSE_QDRANT_PUBLISH_PORT=16334

# AgentScope feature switches
SYNAPSE_AGENTSCOPE_KNOWLEDGE_ENABLED=true
SYNAPSE_AGENTSCOPE_HUBS_ENABLED=false
SYNAPSE_AGENTSCOPE_SCHEDULER_ENABLED=true
SYNAPSE_AGENTSCOPE_CHANNEL_ENABLED=false
SYNAPSE_SCHEDULED_TASKS_ENABLED=true

